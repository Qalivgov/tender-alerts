# Access code for the team page (required while config.json has password_protected: true).
PAGE_PASSWORD=choose-a-code

# Optional email digest. Keep the password in single quotes.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS='your-mailbox-password'
# Optional: who receives the digest (comma-separated). Defaults to SMTP_USER.
MAIL_TO=you@example.com
